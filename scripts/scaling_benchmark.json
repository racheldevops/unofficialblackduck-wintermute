{
  "results_dir": ".benchmark-results",
  "timeout_seconds": 21600,
  "repetitions": 1,
  "workers": [
    4
  ],
  "pipeline_args": [
    "--dry-run",
    "--resolve-bom-names",
    "--strict",
    "--insecure",
    "--debug",
    "--exclude-parent-project",
    "zz-api-parent-rollup-test-20260625-171201",
    "--exclude-child-project",
    "AM_oss-mirage-agentic-backend"
  ],
  "jira_config": "src/wintermute/jira/config/jira-rollup-config.json",
  "environment_names": [
    "BLACKDUCK_URL",
    "BLACKDUCK_API_TOKEN",
    "JIRA_URL",
    "JIRA_USER",
    "JIRA_API_TOKEN",
    "JIRA_PAT",
    "SSL_CERT_FILE"
  ],
  "local": {
    "enabled": true,
    "command": [
      ".venv/bin/python",
      "-m",
      "wintermute.jira.pipeline"
    ]
  },
  "docker": {
    "enabled": false,
    "command": "docker",
    "image": "blackduck-wintermute:local",
    "read_only": true,
    "cpus": 2,
    "memory": "2g",
    "tmpfs": "/tmp:rw,size=1g",
    "extra_run_args": [
      "--env",
      "WINTERMUTE_BLACKDUCK_REQUEST_INTERVAL_SECONDS=0.5",
      "--env",
      "WINTERMUTE_BLACKDUCK_CIRCUIT_BREAKER_THRESHOLD=5",
      "--env",
      "WINTERMUTE_BLACKDUCK_CIRCUIT_BREAKER_WINDOW_SECONDS=60",
      "--env",
      "WINTERMUTE_BLACKDUCK_CACHE_CHECKPOINT_ENTRIES=25",
      "--env",
      "WINTERMUTE_BLACKDUCK_CACHE_CHECKPOINT_SECONDS=30"
    ]
  },
  "kubernetes": {
    "enabled": false,
    "kubectl": "kubectl",
    "namespace": "blackduck-wintermute",
    "cronjob": "blackduck-jira-pipeline",
    "container_name": "jira-pipeline",
    "data_volume_name": "wintermute-data",
    "config_path": "/etc/blackduck-wintermute/jira-rollup-config.json",
    "storage_modes": [
      "emptydir",
      "pvc"
    ],
    "create_pvc": true,
    "pvc_claim_name": "",
    "pvc_size": "5Gi",
    "storage_class": "",
    "cleanup_jobs": true,
    "cleanup_pvc": true,
    "poll_seconds": 5,
    "resources": {
      "requests": {
        "cpu": "1",
        "memory": "512Mi"
      },
      "limits": {
        "cpu": "2",
        "memory": "2Gi"
      }
    }
  }
}
