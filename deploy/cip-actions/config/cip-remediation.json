    "read_workers": 2,
    "evidence_workers": 4,
    "plan_lifetime_hours": 24,
    "limits": {
      "maximum_actions": 100,
      "maximum_blackduck_reads": 500,
      "maximum_blackduck_writes": 10
    }
  },
  "metadata": {}
}
