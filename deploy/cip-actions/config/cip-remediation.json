{
  "schema_version": 1,
  "kernel_repository": {
    "location": "https://gitlab.com/cip-project/cip-kernel/linux-cip.git",
    "revision": "master"
  },
  "security_repository": {
    "location": "https://gitlab.com/cip-project/cip-kernel/cip-kernel-sec.git",
    "revision": "master"
  },
  "remediation": {
    "desired_status": "PATCHED",
    "preserve_existing_decisions": true
  },
