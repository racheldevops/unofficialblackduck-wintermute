{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "credentials",
    "jira",
    "cronJob",
    "pipeline",
    "persistence",
    "blackDuck",
    "config"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "anyOf": [
        {
          "required": ["tag"],
          "properties": {
            "tag": {"type": "string", "minLength": 1}
          }
        },
        {
          "required": ["digest"],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "credentials": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1}
      }
    },
    "jira": {
      "type": "object",
      "required": [
        "url",
        "projectKey",
        "issueType",
        "authMode",
        "apiVersion",
        "verifyTls"
      ],
      "properties": {
        "url": {"type": "string", "pattern": "^https://.+"},
        "projectKey": {"type": "string", "pattern": "\\S"},
        "issueType": {"type": "string", "pattern": "\\S"},
        "authMode": {"enum": ["basic", "bearer"]},
        "apiVersion": {"enum": ["2", "3"]},
        "verifyTls": {"type": "boolean"}
      }
    },
    "cronJob": {
      "type": "object",
      "required": [
        "schedule",
        "timeZone",
        "suspend",
        "concurrencyPolicy",
        "backoffLimit",
        "activeDeadlineSeconds",
        "ttlSecondsAfterFinished",
        "successfulJobsHistoryLimit",
        "failedJobsHistoryLimit"
      ],
      "properties": {
        "schedule": {"type": "string", "minLength": 1},
        "timeZone": {"type": "string", "minLength": 1},
        "suspend": {"type": "boolean"},
        "concurrencyPolicy": {
          "enum": ["Allow", "Forbid", "Replace"]
        },
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "successfulJobsHistoryLimit": {"type": "integer", "minimum": 0},
        "failedJobsHistoryLimit": {"type": "integer", "minimum": 0}
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "mode",
        "confirmApply",
        "maxCreate",
        "strict",
        "resolveBomNames",
        "workers",
        "parentWorkers",
        "rollupWorkers",
        "pageLimit",
        "lockStaleSeconds",
        "extraArgs"
      ],
      "properties": {
        "mode": {"enum": ["dry-run", "apply"]},
        "confirmApply": {"type": "boolean"},
        "maxCreate": {"type": "integer", "minimum": 1},
        "strict": {"type": "boolean"},
        "resolveBomNames": {"type": "boolean"},
        "workers": {"type": "integer", "minimum": 1, "maximum": 8},
        "parentWorkers": {"type": "integer", "minimum": 1, "maximum": 8},
        "rollupWorkers": {"type": "integer", "minimum": 1, "maximum": 8},
        "pageLimit": {"type": "integer", "minimum": 1},
        "lockStaleSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400
        },
        "excludeParentProjects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "excludeChildProjects": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "extraArgs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "size", "accessMode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessMode": {
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        }
      }
    },
    "blackDuck": {
      "type": "object",
      "required": [
        "insecure",
        "requestIntervalSeconds",
        "circuitBreakerThreshold",
        "circuitBreakerWindowSeconds",
        "cacheCheckpointEntries",
        "cacheCheckpointSeconds"
      ],
      "properties": {
        "insecure": {"type": "boolean"},
        "requestIntervalSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "circuitBreakerThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "circuitBreakerWindowSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "cacheCheckpointEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "cacheCheckpointSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "caBundle": {
      "type": "object",
      "properties": {
        "existingConfigMap": {"type": "string"},
        "key": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "config": {
      "type": "object",
      "required": ["issue", "hierarchy", "product_reporting"],
      "properties": {
        "issue": {"type": "object"},
        "hierarchy": {"type": "object"},
        "product_reporting": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "policy_custom_field": {"type": "string"},
            "entity_custom_field": {"type": "string"},
            "phases": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "\\S"}
            },
            "minimum_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "exploit_minimum_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "remediation_statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "\\S"}
            },
            "added_project_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "product_display_names": {
              "type": "object",
              "propertyNames": {"pattern": "\\S"},
              "additionalProperties": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "allow_task_identity_migration": {"type": "boolean"}
          },
          "allOf": [
            {
              "if": {
                "required": ["enabled"],
                "properties": {"enabled": {"const": true}}
              },
              "then": {
                "required": [
                  "policy_custom_field",
                  "entity_custom_field",
                  "phases",
                  "minimum_score",
                  "exploit_minimum_score",
                  "remediation_statuses"
                ],
                "properties": {
                  "policy_custom_field": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "entity_custom_field": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["pipeline"],
        "properties": {
          "pipeline": {
            "required": ["mode"],
            "properties": {"mode": {"const": "apply"}}
          }
        }
      },
      "then": {
        "properties": {
          "pipeline": {
            "properties": {"confirmApply": {"const": true}}
          },
          "persistence": {
            "properties": {"enabled": {"const": true}}
          },
          "cronJob": {
            "properties": {
              "concurrencyPolicy": {"const": "Forbid"},
              "backoffLimit": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["product_reporting"],
            "properties": {
              "product_reporting": {
                "required": ["enabled"],
                "properties": {"enabled": {"const": true}}
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "pipeline": {
            "properties": {"strict": {"const": true}}
          }
        }
      }
    }
  ]
}
